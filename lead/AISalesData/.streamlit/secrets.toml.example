# Copy this file to `secrets.toml` in the same directory and fill it in.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# `secrets.toml` is git-ignored. Never commit the real file.

# OpenAI key used for AI-written emails. Leave out to type it in the sidebar
# each session, or to use manual templates only.
openai_api_key = "sk-..."

# Key used to encrypt saved SMTP passwords in sales_campaign.db.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Setting it here keeps the key out of the folder that holds the database,
# so a copied or backed-up .db file cannot be decrypted on its own. Without
# it the app falls back to an auto-generated `.sender_key` file beside the
# database, which is weaker.
#
# WARNING: if you change this value later, already-saved passwords become
# unreadable and must be re-entered.
sender_encryption_key = "paste-generated-key-here"
